# RiskPilot 环境变量配置
# 复制此文件为 .env 并填入你的 API Key:
#   cp .env.example .env

# ===== LLM API (Stage 2: 规则生成) =====
# 支持 OpenAI 或兼容接口 (如 Azure OpenAI, 本地 Ollama)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# OPENAI_BASE_URL=https://api.openai.com/v1          # 默认 OpenAI 官方
# OPENAI_BASE_URL=https://your-azure-endpoint.openai.azure.com/  # Azure
# OPENAI_BASE_URL=http://localhost:11434/v1           # 本地 Ollama

# ===== Embedding API (Stage 4: 规则向量化, 可选) =====
# 如果不配置，知识库会使用 ChromaDB 默认的本地 embedding
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ===== 其他可选配置 =====
# LOG_LEVEL=INFO
# CUDA_VISIBLE_DEVICES=0                              # 指定 GPU (如果有)
